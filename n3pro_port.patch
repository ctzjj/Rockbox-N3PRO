-
-            if (!isdefault(get_param(element, 2)))
-                data->newval = get_param(element, 2)->data.number;
-            else if (sv_op != 0) /*!touch*/
-                return WPS_ERROR_INVALID_PARAM;
-            data->max = 0;
-            if (sv_op == 1) /*set*/
