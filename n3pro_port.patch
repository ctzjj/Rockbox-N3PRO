+
+	if(nodeptr == NULL) {
+		return NULL;
+	}
+
+	switch(nodeptr->nodeType) {
+	case eELEMENT_NODE:
+		returnNamedNodeMap = (IXML_NamedNodeMap *)malloc(sizeof(IXML_NamedNodeMap));
+		if(returnNamedNodeMap == NULL) {
+			return NULL;
+		}
+
+		ixmlNamedNodeMap_init(returnNamedNodeMap);
