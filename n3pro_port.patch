+};
+
+static const char *gMediaTypes[] = {
+	/*! 0. */
+	NULL,
+	/*! 1. */
+	"audio",
+	/*! 2. */
+	"video",
+	/*! 3. */
+	"image",
+	/*! 4. */
+	"application",
+	/*! 5. */
+	"text"
+};
+
+/*
+ * Defines.
+ */
+
+/* index into 'gMediaTypes' */
