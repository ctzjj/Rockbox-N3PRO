+/*!
+ * \brief Compares thread pool jobs.
+ *
+ * \internal
+ */
+static int CmpThreadPoolJob(
+	void *jobA,
+	void *jobB)
+{
+	ThreadPoolJob *a = (ThreadPoolJob *)jobA;
+	ThreadPoolJob *b = (ThreadPoolJob *)jobB;
+
+	return a->jobId == b->jobId;
+}
