-    skin->gui_wps.data = data = &skin->data;
-#ifdef HAVE_ALBUMART
-    struct skin_albumart *aa_save;
-    unsigned char *buffer = get_skin_buffer(data);
-    /* copy to temp var to protect against memset */
-    if (buffer && (aa_save = SKINOFFSETTOPTR(buffer, data->albumart)))
