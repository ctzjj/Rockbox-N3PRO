+    0x5dee, 0x5df2, 0x5e38, 0x5e73, 0x5ea6, 0x5f0f, 0x5f97, 0x60c5,
+    0x610f, 0x611f, 0x6167, 0x61c9, 0x6230, 0x628a, 0x64cd, 0x6536,
