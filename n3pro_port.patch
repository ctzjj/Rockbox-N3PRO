+/*!
+ * \file
+ *
+ * \brief Contains a function for freeing the memory associated with a upnp 
+ * time out event.
+ */
+
+
+#include "config.h"
+
+
+#include "upnp_timeout.h"
+
+
+#include <stdlib.h> /* for free() */
