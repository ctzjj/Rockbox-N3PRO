+static void battery_page_fill(char *buf, size_t sz, void *ud)
+{
+    extern struct battery_tables_t device_battery_tables;
+    unsigned short *hist = device_battery_tables.history;
+    int pos = 0, y = 0, z = 0;
+    (void)ud;
+
+    battery_read_info(&y, &z);
+#if CONFIG_CHARGING >= CHARGING_MONITOR
+    pos += snprintf(buf + pos, sz - pos, "供电: %s\n",
+                    charging_state() ? "充电中" : "放电中");
+#else
+    pos += snprintf(buf + pos, sz - pos, "供电: 未知\n");
+#endif
+    if (y > 0)
+        pos += snprintf(buf + pos, sz - pos, "电池: %d.%03d V (%d %%)\n",
+                        y / 1000, y % 1000, z);
+    else if (z > 0)
+        pos += snprintf(buf + pos, sz - pos, "电池: %d %%\n", z);
+
+    int tl = battery_time();
+    pos += snprintf(buf + pos, sz - pos, "电量: %d%%   预计可用: ", battery_level());
+    if (tl >= 0)
+        pos += snprintf(buf + pos, sz - pos, "%d 分钟\n", tl);
+    else
+        pos += snprintf(buf + pos, sz - pos, "n/a\n");
+
+#if (CONFIG_BATTERY_MEASURE & VOLTAGE_MEASURE)
+    /* coarse history graph, oldest on the left (like the stock plot) */
+    int minv = hist[0], maxv = hist[0] + 1;
+    for (int i = 1; i < BAT_LAST_VAL && hist[i]; i++)
+    {
+        if (hist[i] > maxv)
+            maxv = hist[i];
+        if (hist[i] < minv)
+            minv = hist[i];
+    }
+    enum { GCOLS = 30, GROWS = 6 };
+    char grid[GROWS][GCOLS + 1];
+    memset(grid, ' ', sizeof grid);
+    for (int c = 0; c < GCOLS; c++)
+    {
+        int idx = BAT_LAST_VAL - 1 - c * 2;
+        if (idx < 0 || !hist[idx])
+            continue;
+        int lvl = (maxv > minv)
+                ? (int)((hist[idx] - minv) * (GROWS - 1) / (maxv - minv)) : 0;
+        for (int r = 0; r <= lvl; r++)
+            grid[GROWS - 1 - r][c] = '#';
+    }
+    for (int r = 0; r < GROWS; r++)
+        grid[r][GCOLS] = 0;
+    pos += snprintf(buf + pos, sz - pos, "\n%d.%03d-%d.%03dV\n",
+                    minv / 1000, minv % 1000, maxv / 1000, maxv % 1000);
+    for (int r = 0; r < GROWS; r++)
+        pos += snprintf(buf + pos, sz - pos, "%s\n", grid[r]);
+
+    pos += snprintf(buf + pos, sz - pos, "\n每分钟变化:\n");
+    for (int i = 0; i < 12 && i < BAT_LAST_VAL - 1; i++)
+    {
+        if (!hist[i] || !hist[i + 1])
+            continue;
+        int d = hist[i] - hist[i + 1];
+        pos += snprintf(buf + pos, sz - pos, "-%2d min: %c%d.%03d V\n", i,
+                        d < 0 ? '-' : ' ', (d < 0 ? -d : d) / 1000,
+                        (d < 0 ? -d : d) % 1000);
+    }
+#endif
+}
+#endif /* HAVE_LVGL_UI */
+
