+/* autoconfig.h -- hand-written replacement for the autoconf-generated
+ * configuration header of pupnp 1.6.21, targeting the Rockbox N3Pro
+ * hosted build (mipsel, glibc, Linux).
+ *
+ * Generated-file substitute; keep in sync with upnp/inc/upnpconfig.h. */
+
+#ifndef PUPNP_AUTOCONFIG_H
+#define PUPNP_AUTOCONFIG_H
+
+#if defined(CAYIN_N3PRO)
+#undef PACKAGE_NAME
+#endif
+#define PACKAGE_NAME "libupnp"
+#if defined(CAYIN_N3PRO)
+#undef PACKAGE_STRING
+#endif
+#define PACKAGE_STRING "libupnp 1.6.21"
+#if defined(CAYIN_N3PRO)
+#undef PACKAGE_VERSION
+#endif
+#define PACKAGE_VERSION "1.6.21"
+
+/* libc availability (glibc) */
+#define HAVE_STRNLEN 1
+#define HAVE_STRNDUP 1
+
+#define UPNP_HAVE_CLIENT 1
+#define UPNP_HAVE_DEVICE 1
+#define UPNP_HAVE_WEBSERVER 1
+#define UPNP_HAVE_SSDP 1
+#define UPNP_HAVE_OPTSSDP 0
