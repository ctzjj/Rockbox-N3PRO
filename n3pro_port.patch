+static int create_ssdp_sock_v6_ula_gua(
+	/*! [] SSDP IPv6 socket to be created. */
+	SOCKET * ssdpSock)
+{
+	char errorBuffer[ERROR_BUFFER_LEN];
+	struct ipv6_mreq ssdpMcastAddr;
