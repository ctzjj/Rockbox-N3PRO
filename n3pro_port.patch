+ * of the License, or (at your option) any later version.
+ *
+ * This software is distributed on an "AS IS" basis, WITHOUT WARRANTY OF ANY
+ * KIND, either express or implied.
+ *
+ ****************************************************************************/
+
+#include "lvgl.h"
+#include "button.h"
+#include "lvgl_ui.h"
+#include "settings.h"
+#include "misc.h"
+
+static lv_indev_drv_t g_indev_pointer;
+static lv_indev_data_t g_last_touch;
+
+/* global edge-swipe-back: start within 48 px of a side edge and drag
+ * 45 px towards the centre (horizontal dominant) to pop the stack */
+#define EDGE_PX   48
+#define SWIPE_PX  45
+
+static lv_coord_t edge_start_x;
+static lv_coord_t edge_start_y;
+static bool edge_armed;
+static bool top_armed;              /* top-edge pull-down (control centre) */
+static bool close_armed;            /* this gesture began with the panel open */
+static lv_indev_state_t edge_prev = LV_INDEV_STATE_RELEASED;
+
+extern int lvgl_shell_locked;
+extern void shell_lock_hide(void);
+
+void lvgui_input_feed(int button, intptr_t data)
+{
+    /* Pointer-mode touch events from button-devinput.c: the queue carries
+     * BUTTON_TOUCHSCREEN (press/repeat) and BUTTON_REL|BUTTON_TOUCHSCREEN,
+     * with coordinates packed in the data word as (x << 16) | y. */
+    if (button & BUTTON_TOUCHSCREEN)
+    {
+        g_last_touch.point.x = (lv_coord_t)((data >> 16) & 0xffff);
+        g_last_touch.point.y = (lv_coord_t)(data & 0xffff);
+        g_last_touch.state = (button & BUTTON_REL)
+                             ? LV_INDEV_STATE_RELEASED
+                             : LV_INDEV_STATE_PRESSED;
+
+        /* the lock screen owns every touch: no edge-back, no pull-down,
+         * and only an upward swipe (>= 80 px) unlocks */
+        if (lvgl_shell_locked)
+        {
+            if (g_last_touch.state == LV_INDEV_STATE_PRESSED &&
+                edge_prev == LV_INDEV_STATE_RELEASED)
+                edge_start_y = g_last_touch.point.y;
+            else if (g_last_touch.state == LV_INDEV_STATE_RELEASED &&
+                     edge_prev == LV_INDEV_STATE_PRESSED &&
+                     edge_start_y - g_last_touch.point.y >= 80)
+                shell_lock_hide();
+            edge_prev = g_last_touch.state;
+            return;
+        }
+
+        /* arm only on the press *edge* (move repeats must not re-arm) */
+        if (g_last_touch.state == LV_INDEV_STATE_PRESSED &&
+            edge_prev == LV_INDEV_STATE_RELEASED)
+        {
+            be_keyclick();
+            edge_armed = g_last_touch.point.x < EDGE_PX ||
+                         g_last_touch.point.x > 360 - EDGE_PX;
+            top_armed = g_last_touch.point.y < 40;
+            /* only a gesture that BEGAN with the panel open may close it */
+            close_armed = lvgui_control_is_open();
+            edge_start_x = g_last_touch.point.x;
+            edge_start_y = g_last_touch.point.y;
+            /* open immediately on a touch in the top strip: the release then
+             * lands on the panel (never on the list below, never closing) */
+            if (top_armed && !close_armed)
+            {
+                lvgui_control_open();
+                top_armed = false;
+            }
+        }
+        else if (g_last_touch.state == LV_INDEV_STATE_PRESSED &&
+                 edge_prev == LV_INDEV_STATE_PRESSED &&
+                 top_armed && !lvgui_control_is_open())
+        {
+            int dy = g_last_touch.point.y - edge_start_y;
+            if (dy > SWIPE_PX)
+            {
+                lvgui_control_open();
+                top_armed = false;
+                edge_armed = false;
+            }
+        }
+        else if (g_last_touch.state == LV_INDEV_STATE_RELEASED)
+        {
+            int dx = g_last_touch.point.x - edge_start_x;
+            int dy = g_last_touch.point.y - edge_start_y;
+            bool swiped = dx > SWIPE_PX || dx < -SWIPE_PX ||
+                          dy > SWIPE_PX || dy < -SWIPE_PX;
+
+            if (lvgui_control_is_open())
+            {
+                if (close_armed && swiped)
+                    lvgui_control_close();
+            }
+            else if (top_armed && dy > SWIPE_PX)
+            {
+                lvgui_control_open();
+            }
+            else if (((edge_start_x < EDGE_PX && dx > SWIPE_PX) ||
+                      (edge_start_x > 360 - EDGE_PX && dx < -SWIPE_PX)) &&
+                     (dx < 0 ? -dx : dx) > (dy < 0 ? -dy : dy))
+            {
+                /* inside a menu job the swipe means "one menu level up":
+                 * popping the screen instead would flash Home while the
+                 * loop pushes the parent level again */
+                bool lvgui_menu_cancel(void);
+                if (!lvgui_menu_cancel())
+                    shell_nav_pop();   /* deferred internally */
+            }
+            edge_armed = false;
+            top_armed = false;
+            close_armed = false;
+        }
+        edge_prev = g_last_touch.state;
+    }
+}
+
+static void pointer_read_cb(lv_indev_drv_t *drv, lv_indev_data_t *data)
+{
+    *data = g_last_touch;   /* keep the last point while released */
+    (void)drv;
+}
+
+void lvgui_port_input_init(void)
+{
+    lv_indev_drv_init(&g_indev_pointer);
+    g_indev_pointer.type = LV_INDEV_TYPE_POINTER;
+    g_indev_pointer.read_cb = pointer_read_cb;
+    lv_indev_drv_register(&g_indev_pointer);
+}
diff --git a/apps/gui/lvglui/lvgl_ui.c b/apps/gui/lvglui/lvgl_ui.c
new file mode 100644
index 0000000000..fb0589e3d9
--- /dev/null
+++ b/apps/gui/lvglui/lvgl_ui.c
@@ -0,0 +1,205 @@
+/***************************************************************************
+ *             __________               __   ___.
+ *   Open      \______   \ ____   ____ |  | _\_ |__  _______  ___
+ *   Source     |       _//  _ \_/ ___\|  |/ /| __ \ /  _ \  \/  /
+ *   Jukebox    |    |   (  <_> )  \___|    < | \_\ (  <_> > <  <
+ *   Firmware   |____|_  /\____/ \___  >__|_ \|___  /\____/__/\_ \
+ *                     \/            \/     \/    \/            \/
+ *
+ * LVGL shell entry for the Cayin N3Pro. Replaces root_menu() as the GUI
+ * thread loop: drains the rockbox button queue once per cycle (HZ/20),
+ * feeds the input port, then runs the LVGL timer handler. The display
+ * flush rides on lcd_update_rect() inside the port layer.
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License
+ * as published by the Free Software Foundation; either version 2
+ * of the License, or (at your option) any later version.
+ *
+ * This software is distributed on an "AS IS" basis, WITHOUT WARRANTY OF ANY
+ * KIND, either express or implied.
+ *
+ ****************************************************************************/
+
+#include <stdio.h>
+#include "lvgl.h"
+#include "kernel.h"
+#include "button.h"
+#include "lcd.h"
+#include "backlight.h"
+#include "powermgmt.h"
+#include "events.h"
+#include "misc.h"
+#include "lvgl_ui.h"
+
+/* The panel loses its content while asleep; LVGL thinks nothing changed.
+ * On wake, mark the whole screen dirty so it gets re-flushed. */
+static volatile bool g_wake_dirty;
+static void lvgui_lcd_activation_hook(unsigned short id, void *event_data)
+{
+    (void)id;
+    (void)event_data;
+    /* Runs on the core/backlight thread: only set a flag here. The UI
+     * loop performs the actual full redraw (screen AND top layer, where
+     * all pages/menus live) once the panel is active again. */
+    g_wake_dirty = true;
+}
+
+/* ---- one iteration of the UI loop + deferred stock actions -------------- */
+
+static void (*g_job_fn)(void *);
+static void *g_job_param;
+static bool g_in_job;
+
+/* True while a deferred (classic) handler runs at the top of the loop --
+ * blocking stock UI (yesno dialogs) is only swapped to LVGL in that
+ * context, never from a rockbox thread. */
+bool lvgui_in_job(void)
+{
+    return g_in_job;
+}
+
+/* Queue a classic (potentially blocking) rockbox handler; it runs at the
+ * top of lvgui_main, never inside an LVGL event callback. */
+void lvgui_run_job(void (*fn)(void *), void *param)
+{
+    g_job_fn = fn;
+    g_job_param = param;
+}
+
+/* One iteration of the main loop: buttons in, LVGL out. Also used by
+ * shell_kbd_input while it blocks a stock handler. */
+void lvgui_idle_pump(void)
+{
+    lv_timer_handler();
+}
+
+/* Run the plugin queued by the stock tree (plugin_open()), then repaint
+ * over whatever it left on the framebuffer. Called from lvgui_ft_enter_path()
+ * inside a job, so the LVGL loop is not running while the plugin draws. */
+extern int root_menu_plugin_screen(void);
+
+int lvgui_plugin_run(void)
+{
+    int rc;
+    rc = root_menu_plugin_screen();
+
+    lv_obj_invalidate(lv_scr_act());
+    lv_obj_invalidate(lv_layer_top());
+    lv_refr_now(NULL);
+    return rc;
+}
+
+/* A .lng was loaded through the browser: the screens behind still hold the
+ * old strings, so refill the wallpaper and rebuild Home; the menu loop
+ * rebuilds the open menu on its next pass. */
+void lvgui_lang_changed(void)
+{
+    shell_theme_refresh();
+    shell_home_rebuild();
+}
+
+static void lvgui_home_key(void)
+{
+    extern int lvgl_shell_locked;
+    /* the lock screen owns the device: only the swipe unlocks */
+    if (lvgl_shell_locked)
+        return;
+    if (lvgui_control_is_open())
+        lvgui_control_close();
+    shell_nav_home();
+}
+
+/* SYS_POWEROFF comes from the power thread (idle timeout, sleep timer,
+ * low battery): only record it here, the toast has to be built on the
+ * GUI thread. */
+static volatile bool g_shutdown_pending;
+static void lvgui_shutdown_event(unsigned short id, void *data)
+{
+    (void)id;
+    (void)data;
+    g_shutdown_pending = true;
+}
+
+void lvgui_pump(void)
+{
+    if (g_shutdown_pending)
+    {
+        g_shutdown_pending = false;
+        shell_shutdown_notice();
+    }
+    if (g_wake_dirty)
+    {
+        g_wake_dirty = false;
+        lv_obj_invalidate(lv_scr_act());
+        lv_obj_invalidate(lv_layer_top());
+        lv_refr_now(NULL);
+    }
+    /* Idle-friendly polling: 20 Hz right after any input, 10 Hz once the
+     * user has been idle for 3 s (halves the wakeups while nothing moves). */
+    static long last_input;
+    long now_ms = lv_tick_get();
+    int tmo = (last_input && now_ms - last_input < 3000) ? HZ / 20 : HZ / 10;
+    int button = button_get_w_tmo(tmo);
+    if (button)
+        last_input = now_ms;
+    if (button)
+    {
+        /* Any user activity wakes the display and postpones idle
+         * poweroff; the LCD_EVENT_ACTIVATION hook reflushes the
+         * framebuffer content lost while the panel slept. */
+        backlight_on();
+        reset_poweroff_timer();
+        /* The N3Pro's rotary encoder is the volume knob; button-n3pro.c
+         * maps it to the scroll buttons (FWD = down, BACK = up). Drive
+         * the rockbox volume core so every screen (and the status bar)
+         * follows. */
+        if (button & BUTTON_SCROLL_FWD)
+            adjust_volume(-1);
+        else if (button & BUTTON_SCROLL_BACK)
+            adjust_volume(1);
+        /* the bottom-front touch key under the status LED is the HOME key */
+        if (button & BUTTON_HOME)
+        {
+            if (!(button & (BUTTON_REL | BUTTON_REPEAT)))
+                lvgui_home_key();
+            button &= ~BUTTON_HOME;
+        }
+        lvgui_input_feed(button, button_get_data());
+    }
+    lv_timer_handler();
+}
+
+void lvgui_main(void)
+{
+    lv_init();
+    lvgui_port_disp_init();
+    lvgui_port_input_init();
+    lvgui_shell_start();
+    add_event(SYS_POWEROFF, lvgui_shutdown_event);
+    shell_start_screen_apply();   /* Start Screen setting */
+    add_event(LCD_EVENT_ACTIVATION, lvgui_lcd_activation_hook);
+
+    while (1)
+    {
+        lvgui_pump();
+        /* Stock rockbox handlers are deferred to this top level (outside
+         * lv_timer_handler): the ones that pop classic UI block their
+         * caller, and shell_kbd_input pumps LVGL while it waits -- nesting
+         * lv_timer_handler would be unsafe. */
+        if (g_job_fn)
+        {
+            void (*fn)(void *) = g_job_fn;
+            void *param = g_job_param;
+            g_job_fn = NULL;
+            g_in_job = true;
+            fn(param);
+            g_in_job = false;
+            /* drop list-picker screens left on the nav stack by the job */
+            shell_pick_cleanup();
+            /* classic splash(0,...) only lived for the blocking call's
+             * duration; make sure a sticky toast cannot outlive its job */
+            shell_toast_clear();
+        }
+    }
+}
diff --git a/apps/gui/lvglui/lvgl_ui.h b/apps/gui/lvglui/lvgl_ui.h
new file mode 100644
index 0000000000..cf71310c18
