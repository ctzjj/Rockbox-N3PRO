+void be_media_step(int dir)
+{
+    if (netfm_stream_is_active() || netfm_playback_active())
+    {
+        be_netfm_step(dir);
+        return;
+    }
+    step_init();
+    queue_post(&step_q, dir > 0 ? 1 : 2, 0);
+}
