+int UpnpSendAdvertisement(UpnpDevice_Handle Hnd, int Exp)
+{
+    UpnpPrintf(UPNP_ALL, API, __FILE__, __LINE__,
+        "Inside UpnpSendAdvertisement \n");
+    return UpnpSendAdvertisementLowPower (Hnd, Exp, -1, -1, -1);
