+	[CONNMGR_VAR_CUR_CONN_IDS] = "CurrentConnectionIDs",
+	[CONNMGR_VAR_AAT_CONN_STATUS] = "A_ARG_TYPE_ConnectionStatus",
+	[CONNMGR_VAR_AAT_CONN_MGR] = "A_ARG_TYPE_ConnectionManager",
