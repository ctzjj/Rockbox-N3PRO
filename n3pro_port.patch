-static void update_gui(struct gui_synclist * playlist_lists, bool init)
-{
-    if (init)
-        gui_synclist_init(playlist_lists, playlist_callback_name,
-                          &viewer, false, 1, NULL);
-    gui_synclist_set_nb_items(playlist_lists, viewer.num_tracks);
