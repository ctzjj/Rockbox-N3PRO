+
+    *response_node = NULL;      /* init */
+
+    err_code = UPNP_E_OUTOF_MEMORY; /* default error */
+
+    UpnpPrintf( UPNP_INFO, SOAP, __FILE__, __LINE__,
+        "Inside SoapSendActionEx():" );
