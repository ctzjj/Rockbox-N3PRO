+/*!
+ * \brief Version of strdup() that handles NULL input.
+ *
+ * \return The same as strdup().
+ */
+static char *safe_strdup(
+	/*! [in] String to be duplicated. */
+	const char *s) 
+{
+	assert(s != NULL);
+
+	if (s == NULL) {
+		return strdup((const char*)"");
+	}
+	return strdup(s);
+}
