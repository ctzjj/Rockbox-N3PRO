-
-    return (id3_retrieval_successful &&
-            browse_id3_ex(viewer.id3, viewer.playlist, current_track->display_index,
-                          viewer.num_tracks, NULL, 1,
-                          viewer.allow_view_text_plugin ? NULL : &view_text)) ?
