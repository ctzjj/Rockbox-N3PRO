-    gui_synclist_set_icon_callback(playlist_lists,
-                  global_settings.playlist_viewer_icons?
-                  &playlist_callback_icons:NULL);
-    gui_synclist_set_title(playlist_lists, viewer.title, Icon_Playlist);
