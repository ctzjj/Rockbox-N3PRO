+#define BT_MAX_DEVICES 32
+#define BT_NAME_LEN 80
+#define BT_LOCAL_PLAYBACK_DEVICE "plughw:0,0"
+#define BT_ASOUND_CONF "/etc/asound.conf"
+#define BT_AUDIO_CONF "/etc/bluetooth/audio.conf"
