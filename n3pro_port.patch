+static const unsigned short jis0208[84][94] = {
+#include "jis0208.h"
+};
+
+static const unsigned short gb18030[126][190] = {
+#include "gb18030.h"
+};
+
+static const unsigned short gb18030utf[][2] = {
+#include "gb18030utf.h"
+};
+
+static const unsigned short big5[89][157] = {
+#include "big5.h"
