+/* ---- hooks for the LVGL context menu ------------------------------------
+ * The LVGL UI builds its own list from the real tree_onplay_menu and calls
+ * the very same item functions, so behaviour/memory handling stay stock. */
+void onplay_prepare(const char *path, int attr)
+{
+    onplay_result = ONPLAY_OK;
+    ctx_current_playlist_insert = NULL;
+    selected_file_set(CONTEXT_TREE, NULL, attr);
+    ctx_add_to_playlist = NULL;
+    if (path != NULL)
+    {
+        strmemccpy(selected_file.buf, path, MAX_PATH);
+        selected_file.path = selected_file.buf;
+    }
+}
+
+int onplay_result_code(void)
+{
+    return onplay_result;
+}
+
+const struct menu_item_ex *onplay_tree_menu(void)
+{
+    return &tree_onplay_menu;
+}
+
+/* Let the LVGL UI substitute its own native implementation for a few
+ * items (0 = none, 1 = properties, 2 = delete file/dir). */
+/* match a menu item by the function it invokes (robust even when the item
+ * is reached through a submenu's item-pointer array) */
+static bool onplay_fn_is(const struct menu_item_ex *item, void *fn)
+{
+    if ((item->flags & MENU_TYPE_MASK) != MT_FUNCTION_CALL)
+        return false;
+    return (void *)item->function->function == fn;
+}
+
+int onplay_item_kind(const struct menu_item_ex *item)
+{
+    if (item == &properties_item || item == &track_info_item)
+        return 1;                          /* show properties/id3 info */
+    if (item == &delete_file_item || item == &delete_dir_item)
+        return 2;                          /* delete */
+    if (item == &rename_file_item)
+        return 3;                          /* rename */
+    if (item == &create_dir_item)
+        return 4;                          /* create directory */
+    if (item == &list_viewers_item)
+        return 5;                          /* open with... */
+    if (item == &reveal_item)
+        return 6;                          /* reveal in file browser */
+    if (item == &cat_add_to_list ||
+        onplay_fn_is(item, (void *)cat_add_to_a_playlist))
+        return 8;                          /* add to existing playlist */
+    if (item == &cat_add_to_new ||
+        onplay_fn_is(item, (void *)cat_add_to_a_new_playlist))
+        return 9;                          /* create new playlist */
+    return 0;
+}
+
