     return simplelist_text[item];
 }
 
+#ifdef HAVE_LVGL_UI
+static struct simplelist_info *sl_info;
+static struct gui_synclist *sl_lists;
+
+/* re-render one row label (used by the live-refresh path) */
+static void sl_fill_cb(int idx, char *buf, size_t sz, void *ud)
+{
+    list_get_name *getname;
+    const char *s;
+    (void)ud;
+    if (!sl_info)
+        return;
+    getname = sl_info->get_name ? sl_info->get_name
+                                : simplelist_static_getname;
+    buf[0] = '\0';
+    s = getname(idx, sl_info->callback_data, buf, sz);
+    if (!s)
+        s = "";
+    if (s != buf)
+        snprintf(buf, sz, "%s", s);
+}
+
+/* the stock timeout tick: refreshes the status data (ACTION_NONE) */
+static void sl_tick_cb(void *ud)
+{
+    (void)ud;
+    if (sl_info && sl_info->action_callback && sl_lists)
+        sl_info->action_callback(ACTION_NONE, sl_lists);
+}
+
+static bool simplelist_lvgl_pick(struct simplelist_info *info)
+{
+    list_get_name *getname = info->get_name ? info->get_name
+                                            : simplelist_static_getname;
+    int count = info->get_name ? info->count : simplelist_line_count;
+    static char bufs[128][112];
+    static const char *labels[128];
+    struct gui_synclist lists;
+    int i, sel;
+
+    if (count <= 0 || count > 128)
+        return false; /* let the classic renderer handle it */
+
+    gui_synclist_init(&lists, getname, info->callback_data,
+                      info->scroll_all, info->selection_size, NULL);
+    gui_synclist_set_nb_items(&lists, count * info->selection_size);
+    gui_synclist_select_item(&lists, info->selection);
+    sl_info = info;
+    sl_lists = &lists;
+
+    for (i = 0; i < count; i++)
+    {
+        bufs[i][0] = '\0';
+        labels[i] = getname(i, info->callback_data, bufs[i], sizeof bufs[i]);
+        if (!labels[i])
+            labels[i] = bufs[i];
+    }
+
+    /* home-style first-character tiles, tinted by the stock icon class */
+    static const char *sl_icns[128];
+    static char sl_icbuf[128][8];
+    static int sl_grads[128];
+    if (info->get_icon)
+    {
+        for (i = 0; i < count; i++)
+        {
+            lvgui_menu_icon((int)info->get_icon(i, info->callback_data),
+                            &sl_grads[i]);
+            lvgui_first_char(labels[i], sl_icbuf[i], sizeof sl_icbuf[i]);
+            sl_icns[i] = sl_icbuf[i][0] ? sl_icbuf[i] : NULL;
+        }
+        shell_pick_icons(sl_icns, count);
+        shell_pick_grads(sl_grads, count);
+    }
+    else
+    {
+        shell_pick_icons(NULL, 0);
+        shell_pick_grads(NULL, 0);
+    }
+
+    /* Stock semantics: a list is only refreshed periodically when its
+     * callback asks for ACTION_REDRAW on ACTION_NONE (status screens).
+     * Plain menus must stay on the static path. */
+    bool live = false;
+    if (info->timeout > 0 && info->action_callback)
+        live = (info->action_callback(ACTION_NONE, &lists) == ACTION_REDRAW);
+
+    while (1)
+    {
+        if (live)
+        {
+            /* status screen: periodic refresh through the stock
+             * callback (netfm/bt-rx/wifi/dlna style lists) */
+            sel = shell_list_pick_refresh(info->title, count,
+                info->selection, (int)(info->timeout * 1000 / HZ),
+                sl_tick_cb, sl_fill_cb, NULL);
+        }
+        else
+        {
+            sel = shell_list_pick(info->title, labels, count,
+                                  info->selection);
+        }
+        if (sel < 0)
+        {
+            info->selection = -1;
+            if (info->action_callback)
+                info->action_callback(ACTION_STD_CANCEL, &lists);
+            return true;
+        }
+        if (info->action_callback)
+        {
+            int act;
+            gui_synclist_select_item(&lists, sel);
+            act = info->action_callback(ACTION_STD_OK, &lists);
+            if (act != ACTION_STD_OK && act != ACTION_STD_CANCEL)
+                continue; /* callback keeps the list open */
+        }
+        info->selection = sel;
+        return true;
+    }
+}
+#endif /* HAVE_LVGL_UI */
+
 bool simplelist_show_list(struct simplelist_info *info)
 {
+#ifdef HAVE_LVGL_UI
+    if (lvgui_in_job() && simplelist_lvgl_pick(info))
+        return false;
+#endif
     struct gui_synclist lists;
     int action, old_line_count = simplelist_line_count;
     list_get_name *getname;
