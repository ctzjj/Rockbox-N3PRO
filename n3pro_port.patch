+			rc = ixmlNamedNodeMap_addToNamedNodeMap(&returnNamedNodeMap, tempNode);
+			if(rc != IXML_SUCCESS) {
+				ixmlNamedNodeMap_free(returnNamedNodeMap);
+				return NULL;
+			}
+
+			tempNode = tempNode->nextSibling;
+		}
+		return returnNamedNodeMap;
+	default:
+		/* if not an ELEMENT_NODE */
+		return NULL;
+	}
