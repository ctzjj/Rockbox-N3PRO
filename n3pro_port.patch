+	/*! [in] The name space URI item to free. */
+	IXML_NamespaceURI *pNsURI)
+{
+    assert( pNsURI != NULL );
+    if( pNsURI->nsURI != NULL ) {
+        free( pNsURI->nsURI );
+    }
+    if( pNsURI->prefix != NULL ) {
+        free( pNsURI->prefix );
+    }
