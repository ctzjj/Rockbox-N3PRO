+#define HTTP_INSUFFICIENT_STORAGE           507
+#define HTTP_LOOP_DETECTED                  508
+#define HTTP_NOT_EXTENDED                   510
+
+/* HTTP lib error codes */
+
+#define HTTP_E_OUT_OF_MEMORY    -2
