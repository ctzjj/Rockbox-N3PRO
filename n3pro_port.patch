+                            { 300, 300, 180, 50, 0x8A6CFF },
+                            { 200, 450, 150, 45, 0x5AD0E8 } } }, /* midnight */
+    { 0xB08A5C, 0x8A6A4A, { { 120, 130, 165, 60, 0xE8C48A },
+                            { 300, 320, 175, 55, 0xC08A5C },
+                            { 200, 450, 145, 45, 0xF2E0B8 } } }, /* dune */
