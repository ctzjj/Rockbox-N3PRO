-    int params_count = element->params_count;
-    if (params_count == 0)
-    {
-        switch (token->type)
-        {
-            case SKIN_TOKEN_SUBLINE_TIMEOUT:
-                return -1;
-            case SKIN_TOKEN_BUTTON_VOLUME:
-            case SKIN_TOKEN_TRACK_STARTING:
-            case SKIN_TOKEN_TRACK_ENDING:
-                val = 10;
-                break;
-            default:
