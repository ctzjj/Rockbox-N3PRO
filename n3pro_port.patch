+#define VIDEO_STR        "\2"
+#define IMAGE_STR        "\3"
+#define APPLICATION_STR  "\4"
+#define TEXT_STR         "\5"
+
+/* int index */
+#define APPLICATION_INDEX 4
+#define TEXT_INDEX        5
+
+/* general */
+#define NUM_MEDIA_TYPES       70
+#define NUM_HTTP_HEADER_NAMES 33
+
+#define ASCTIME_R_BUFFER_SIZE 26
+#ifdef WIN32
+static char *web_server_asctime_r(const struct tm *tm, char *buf)
+{
+	if (tm == NULL || buf == NULL)
