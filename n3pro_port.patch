+$(BUILDDIR)/lib/lvgl/src/%.o: $(LVGL_DIR)/src/%.c
+	$(SILENT)mkdir -p $(dir $@)
+	$(call PRINTS,CC $(subst $(ROOTDIR)/,,$<))$(CC) -c $< -o $@ $(LVGLFLAGS)
+
+$(LVGL): $(LVGL_OBJ)
+	$(SILENT)mkdir -p $(dir $@)
+	$(call PRINTS,AR $(@F))$(AR) rcs $@ $^ >/dev/null
+
+CORE_LIBS := $(LVGL) $(CORE_LIBS)
