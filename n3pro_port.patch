-            return WPS_ERROR_INVALID_PARAM;
-    }
-    else
-    {
-        const struct settings_list *setting = find_setting_by_cfgname(temp);
-        if (!setting) {
-            DEBUGF("Invalid setting [%s]\n", temp);
-            return WPS_ERROR_INVALID_PARAM;
-        }
-        token->value.xdata = (void *)setting;
-    }
-    return 0;
-}
