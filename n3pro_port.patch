+
+/*!
+ * \brief Clear token buffer.
+ */
+static void Parser_clearTokenBuf(
+	/*! [in] The XML parser. */
+	Parser *xmlParser)
+{
+    ixml_membuf_destroy( &( xmlParser->tokenBuf ) );
+}
